@article{shipley_opensource_2018,
	title = {An open‐source sensor‐logger for recording vertical movement in free‐living organisms},
	volume = {9},
	issn = {2041-210X},
	url = {https://besjournals.onlinelibrary.wiley.com/doi/10.1111/2041-210X.12893},
	doi = {10.1111/2041-210X.12893},
	abstract = {{\textless}p{\textgreater} {\textless}list{\textgreater} {\textless}list-item{\textgreater} {\textless}p{\textgreater}Measuring individual‐based movements in free‐ranging animals is relevant to our understanding of many basic ecological principles (migration, competition, optimal foraging) but has been difficult to realize in a small size.{\textless}/p{\textgreater} {\textless}/list-item{\textgreater} {\textless}list-item{\textgreater} {\textless}p{\textgreater}We have developed a freely available, open‐source, non‐invasive datalogger that can measure an animal's altitude or elevation (A) at sampling intervals greater than once per second, storing up to 10,000 total samples, depending on programme size.{\textless}/p{\textgreater} {\textless}/list-item{\textgreater} {\textless}list-item{\textgreater} {\textless}p{\textgreater}The realized design weighs 370 mg, opening a wealth of opportunities to study animals as small as 10 g without exceeding the 4\% rule‐of‐thumb for the relative mass of telemetry devices.{\textless}/p{\textgreater} {\textless}/list-item{\textgreater} {\textless}list-item{\textgreater} {\textless}p{\textgreater}In addition, power management is provided via a modern ultra‐low‐power microcontroller, making it possible to record altitude data over extended periods (\&gt;100 days) by extending battery lifetimes.{\textless}/p{\textgreater} {\textless}/list-item{\textgreater} {\textless}list-item{\textgreater} {\textless}p{\textgreater}First results from testing and field applications of this design underline its suitability for reliable and extended monitoring of how animals interact with the environment. Our empirical results show this design can provide high‐resolution data with altitude measurements accurate to the nearest several metres at 1‐s intervals, provided a local known elevation pressure reference, elucidating fine‐scale differences between species/individuals in their use of the air column over 10‐day intervals.{\textless}/p{\textgreater} {\textless}/list-item{\textgreater} {\textless}/list{\textgreater} {\textless}/p{\textgreater}},
	number = {3},
	journal = {Methods in Ecology and Evolution},
	author = {Shipley, J. Ryan and Kapoor, Julian and Dreelin, Richard A. and Winkler, David W.},
	editor = {Lecomte, Nicolas},
	month = mar,
	year = {2018},
	keywords = {altitude, ambient temperature, animal movement, foraging behaviour, migration, open-source, telemetry},
	pages = {465--471},
	file = {PDF:/Users/rafnuss/Zotero/storage/2LC5YI8L/Methods Ecol Evol - 2017 - Shipley - An open‐source sensor‐logger for recording vertical movement in free‐living organisms.pdf:application/pdf},
