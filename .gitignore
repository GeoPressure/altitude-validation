# Raw and intermediate data are large and re-downloadable: see run_all.R.
data/
*.tmp
.Rhistory
.RData
.Rproj.user/
.DS_Store
logs/
_site/

# Reproducible document build files and visual-check previews.
**/*_files/
**/*_cache/
**/.quarto/
paper/*.tex
!paper/title-block.tex
tmp/

# Generated journal submission packages.
output/submission/
paper/*.log
paper/*.aux
paper/*.out
paper/*.toc

# Copyrighted reference material stays local: PDFs and extracted full texts.
paper/pdfs/
literature/references/*
!literature/references/.gitignore

# Rendered documents other than the manuscript and supplement PDFs.
paper/*.html
paper/cover-letter.pdf

# Exploratory outputs.
output/drafts/
